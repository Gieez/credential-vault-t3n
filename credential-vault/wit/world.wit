/// VaultGate credential-vault WIT world v0.4.1 (host-tenant@2.0.0 / host-interfaces@2.2.0).
package z:credential-vault@0.4.2;

world credential-vault {
    import host:tenant/tenant-context@2.0.0;
    import host:interfaces/logging@2.2.0;
    import host:interfaces/kv-store@2.2.0;
    import host:interfaces/http@2.2.0;
    import host:interfaces/http-with-placeholders@2.2.0;

    export contracts;
}

interface contracts {
    record generic-input {
        input:        option<list<u8>>,
        user-profile: option<list<u8>>,
        context:      option<list<u8>>,
    }

    store-credential:  func(req: generic-input) -> result<list<u8>, string>;
    list-credentials:  func(req: generic-input) -> result<list<u8>, string>;
    revoke-credential: func(req: generic-input) -> result<list<u8>, string>;
    proxy-call:        func(req: generic-input) -> result<list<u8>, string>;
    send-email:        func(req: generic-input) -> result<list<u8>, string>;
    get-activity-log:  func(req: generic-input) -> result<list<u8>, string>;
}
